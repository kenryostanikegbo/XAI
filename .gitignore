# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
*.egg-info/

# Claude / agent state
.claude/
.claude.json

# Notebooks (kept on disk; not deployed)
notebooks/

# Build artifacts
*.lock
*.docx
*.pdf
*.tmp

# OULAD raw source files — large and not used by the dashboard at runtime.
# The dashboard reads only processed artifacts (data/processed/, outputs/).
data/raw/

# GridSearchCV diagnostic artifacts — kept on disk for reproducibility but the
# dashboard only loads `*_best.joblib`. Excluding these drops the runtime image
# by ~92 MB.
outputs/models/*_search.joblib

# Outputs we deliberately DO ship: outputs/models/*_best.joblib,
# outputs/models/shap_explainer_*.joblib, outputs/models/shap_values_*.npy,
# outputs/models/shap_indices_strat.npy, outputs/figures/, outputs/tables/,
# data/processed/. The app reads them at runtime.
